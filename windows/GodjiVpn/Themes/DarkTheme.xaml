<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Дизайн v5 «Стекло», тёмная тема — 1:1 с Android GodjiColors.applyDark() (Color.kt).
         Surface здесь тёмный: в экранах это цвет текста на акцентной/Ink-кнопке. -->
    <SolidColorBrush x:Key="BgBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="BgSolidBrush" Color="#0C1320"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0B1F1C"/>
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="InkBrush" Color="#F1F7F6"/>
    <SolidColorBrush x:Key="InkShadowBrush" Color="#C7CBD4"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCE8EEF4"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#99E8EEF4"/>
    <SolidColorBrush x:Key="TealBrush" Color="#5FFFE6"/>
    <Color x:Key="TealColor">#5FFFE6</Color>
    <SolidColorBrush x:Key="TealBrightBrush" Color="#34E3D2"/>
    <SolidColorBrush x:Key="TealDeepBrush" Color="#7FFFEA"/>
    <SolidColorBrush x:Key="TealTintBrush" Color="#242FE0CF"/>
    <SolidColorBrush x:Key="TealTintBorderBrush" Color="#595FFFE6"/>
    <SolidColorBrush x:Key="TerracottaBrush" Color="#FF8E62"/>
    <SolidColorBrush x:Key="TerracottaDeepBrush" Color="#FFB08E"/>
    <SolidColorBrush x:Key="TerracottaTintBrush" Color="#6178321C"/>
    <SolidColorBrush x:Key="TerracottaTintBorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E0A63C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7A66"/>
    <SolidColorBrush x:Key="JamBgBrush" Color="#66782819"/>
    <SolidColorBrush x:Key="JamBorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="JamTextBrush" Color="#FF8A6E"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBgBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="BorderTealBrush" Color="#262FE0CF"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CFF"/>

    <!-- Стекло v5 -->
    <SolidColorBrush x:Key="HairBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SelBgBrush" Color="#172FE0CF"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="LensBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="RingCoreBrush" Color="#E610141C"/>
    <SolidColorBrush x:Key="InkBtnBrush" Color="#F1F7F6"/>
    <SolidColorBrush x:Key="InkBtnTextBrush" Color="#0B1F1C"/>
    <SolidColorBrush x:Key="PressedRowBrush" Color="#147F7F7F"/>
    <SolidColorBrush x:Key="BannerOkBrush" Color="#61145A50"/>
    <SolidColorBrush x:Key="BannerWarnBrush" Color="#666E2D19"/>
    <SolidColorBrush x:Key="ConnectingDotBrush" Color="#E0A526"/>
    <SolidColorBrush x:Key="OffDotBrush" Color="#59FFFFFF"/>
    <Color x:Key="AccentGlowColor">#592FE0CF</Color>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#34E3D2" Offset="0"/>
        <GradientStop Color="#10B8A9" Offset="0.55"/>
        <GradientStop Color="#079487" Offset="1"/>
    </LinearGradientBrush>

    <!-- Рецепт стекла (GlassPanel, см. Controls/GlassPanel.cs) -->
    <Color x:Key="GlassColor">#9E12161E</Color>
    <Color x:Key="GlassStrongColor">#BD161A24</Color>
    <Color x:Key="GlassFaintColor">#6612161E</Color>
    <Color x:Key="GlassSpotColor">#12FFFFFF</Color>
    <Color x:Key="GlassGlossColor">#12FFFFFF</Color>
    <Color x:Key="RimAColor">#8CFFFFFF</Color>
    <Color x:Key="RimBColor">#14FFFFFF</Color>
    <Color x:Key="RimCColor">#05FFFFFF</Color>
    <Color x:Key="RimDColor">#47FFFFFF</Color>
    <Color x:Key="InnerTopColor">#47FFFFFF</Color>
    <Color x:Key="InnerBottomColor">#80000000</Color>
    <Color x:Key="GlassShadowColor">#590A0528</Color>

    <!-- Фон (GlassBackdrop) -->
    <Color x:Key="BaseTopColor">#080C12</Color>
    <Color x:Key="BaseMidColor">#0C1320</Color>
    <Color x:Key="BaseBottomColor">#06100F</Color>
    <Color x:Key="Blob1Color">#0F8C80</Color>
    <Color x:Key="Blob2Color">#4332A8</Color>
    <Color x:Key="Blob3Color">#8A3D2A</Color>
    <Color x:Key="Blob4Color">#1B4F8C</Color>
    <sys:Double x:Key="BlobAlpha">0.32</sys:Double>
    <Color x:Key="TexLineColor">#09A0DCE6</Color>
    <Color x:Key="TexDotColor">#0FC8E6F0</Color>

    <!-- Совместимость со старыми именами ресурсов из MVP-каркаса. -->
    <SolidColorBrush x:Key="PanelBrush" Color="#9E12161E"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#9E12161E"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5FFFE6"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#7FFFEA"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F7FA"/>

</ResourceDictionary>
