<Window x:Class="GodjiVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GodjiVpn.Controls"
        Title="Godji VPN" Height="860" Width="460"
        MinHeight="640" MinWidth="380"
        Background="{DynamicResource BgSolidBrush}"
        Icon="pack://application:,,,/Assets/Images/logo.png"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">
    <!-- v5 «Стекло»: общий фон GlassBackdrop рисуется один раз под всем окном — экраны сами
         прозрачны (BgBrush = Transparent), иначе стеклянные карточки выглядели бы просто
         серыми плашками. Контент ограничен MaxWidth (вёрстка под мобильную ширину): при
         развёрнутом окне по бокам виден тот же фон, как в Telegram Desktop и т.п. -->
    <Grid>
        <controls:GlassBackdrop/>
        <ContentControl Content="{Binding CurrentViewModel}" MaxWidth="520" HorizontalAlignment="Stretch"/>
    </Grid>
</Window>
