<UserControl x:Class="GodjiVpn.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <!-- Главная v5 «Стекло» — по эталону screens/*-connect.png и ConnectScreen.kt (Android):
         поля 16, промежутки 12, всё прозрачно поверх общего фона. Без прокрутки: глобус
         занимает оставшееся место и ужимается, если остальному нужно больше (крупный шрифт). -->
    <Grid Margin="16,14,16,8" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

            <!-- Шапка лежит ПОВЕРХ верхнего края глобуса (он заходит под неё) — ZIndex. -->
            <Grid Grid.Row="0" Panel.ZIndex="2">
                <controls:GlassPanel Style="{StaticResource GlassPill}" HorizontalAlignment="Left" Padding="4,4,12,4">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource InkBrush}">
                            <Image Source="pack://application:,,,/Assets/Images/logo.png" Width="20" Height="20"/>
                        </Border>
                        <TextBlock Text="Goji" FontWeight="Bold" FontSize="{s:Fs 14}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </controls:GlassPanel>
                <controls:GlassPanel Style="{StaticResource GlassPill}" HorizontalAlignment="Right" Height="34" Padding="13,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TealDeepBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNetwork}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource JamTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding NetLabel}" FontWeight="Bold" FontSize="{s:Fs 12}" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource ManropeFamily}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TealDeepBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNetwork}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource JamTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </controls:GlassPanel>
            </Grid>

            <!-- Глобус без карточки: холст заходит на 44 под шапку и на 42 под кнопку, по ширине +60
                 с каждой стороны; вокруг сферы — общий фон. Высота — всё оставшееся место. -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <controls:GlobeHost x:Name="Globe" Margin="-60,-44,-60,-42"/>
                <controls:GlassPanel Style="{StaticResource GlassPill}" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,6,14,0" MaxWidth="190" Padding="13,9"
                                     Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding GreetingHi}" FontWeight="Bold" FontSize="{s:Fs 20}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding GreetingSub}" FontWeight="SemiBold" FontSize="{s:Fs 9}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </controls:GlassPanel>
            </Grid>

            <StackPanel Grid.Row="2">
            <!-- Кнопка 80 по центру + заголовок и строка статуса под ней. -->
            <controls:PowerButton Margin="0,12,0,0" IsOn="{Binding IsConnected}" IsBusy="{Binding IsConnecting}"
                                  Command="{Binding ToggleCommand}"/>
            <TextBlock Text="{Binding Headline}" FontWeight="Bold" FontSize="{s:Fs 26}" TextAlignment="Center" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource OffDotBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource ConnectingDotBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource TealBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Subline}" FontWeight="SemiBold" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                <TextBlock FontWeight="Bold" FontSize="{s:Fs 13}" Margin="7,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Run Text="·"/> <Run Text="{Binding ConnectedTimeLabel, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" FontSize="{s:Fs 12}"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

            <!-- Скорость: ОДНА карточка, две колонки через вертикальный Hair. -->
            <controls:GlassPanel Style="{StaticResource GlassCard}" Padding="4,14" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconArrowDown}" Style="{StaticResource Icon}" Width="12" Height="12" Fill="{DynamicResource TealBrush}"/>
                            <TextBlock Text="Скачивание" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Run Text="{Binding DownSpeedLabel, Mode=OneWay}" FontWeight="Bold" FontSize="{s:Fs 22}"/><Run Text=" МБ/с" FontWeight="SemiBold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Style="{StaticResource VHair}"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconArrowUp}" Style="{StaticResource Icon}" Width="12" Height="12" Fill="{DynamicResource TerracottaBrush}"/>
                            <TextBlock Text="Отдача" FontWeight="SemiBold" FontSize="{s:Fs 10.5}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Run Text="{Binding UpSpeedLabel, Mode=OneWay}" FontWeight="Bold" FontSize="{s:Fs 22}"/><Run Text=" МБ/с" FontWeight="SemiBold" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </controls:GlassPanel>

            <!-- Текущий узел — строка-кнопка на всю ширину карточки, открывает "Серверы". -->
            <controls:GlassPanel Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <Button Style="{StaticResource RowButton}" Command="{Binding OpenServersCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource ChipBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Border Width="24" Height="17" CornerRadius="3" ClipToBounds="True"
                                        Visibility="{Binding CurrentFlagImagePath, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Image Source="{Binding CurrentFlagImagePath}" Stretch="UniformToFill"/>
                                </Border>
                                <Path Data="{StaticResource IconGlobe}" Style="{StaticResource Icon}" Width="18" Height="18"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Visibility="{Binding CurrentFlagImagePath, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentNodeName}" FontWeight="Bold" FontSize="{s:Fs 14}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentNodeMeta}" FontWeight="Medium" FontSize="{s:Fs 11.5}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding CurrentNodeMeta, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" Style="{StaticResource Icon}" Width="16" Height="16"
                              Fill="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Button>
            </controls:GlassPanel>

            <!-- Трафик: "Трафик" / значение, полоса с бегущим бликом, срок подписки. -->
            <controls:GlassPanel Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <Button Style="{StaticResource RowButton}" Padding="14" Command="{Binding OpenTrafficCommand}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Трафик" FontWeight="SemiBold" FontSize="{s:Fs 12}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TrafficValueLabel}" FontWeight="Bold" FontSize="{s:Fs 13}" HorizontalAlignment="Right"/>
                        </Grid>
                        <controls:ShimmerBar Value="{Binding TrafficFraction}" Margin="0,9,0,0"
                                             Visibility="{Binding ShowTrafficBar, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding TrafficExpiryLabel}" FontWeight="Medium" FontSize="{s:Fs 11}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,9,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </controls:GlassPanel>
            </StackPanel>

    </Grid>
</UserControl>
