<UserControl x:Class="GodjiVpn.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <UserControl.Resources>
        <!-- Вкладка таб-бара v5: иконка из эталона (обводка) + подпись 10 Bold, выбранная —
             TealDeep, остальные — TextSecondary. Сама "линза" под выбранной вкладкой — отдельный
             слой (Lens ниже), вкладка прозрачна. -->
        <Style x:Key="GlassTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="21" Height="21" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{StaticResource ManropeFamily}" FontWeight="Bold" FontSize="{s:Fs 10}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TealDeepBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BgBrush}">
        <!-- 64 капсула + 10 отступ снизу + 10 воздуха — контент не уходит под таб-бар. -->
        <Grid Margin="0,0,0,84">
            <ContentControl Content="{Binding Connect}"
                             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}"/>
            <ContentControl Content="{Binding Servers}"
                             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}"/>
            <ContentControl Content="{Binding Plans}"
                             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}"/>
            <ContentControl Content="{Binding Settings}"
                             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}"/>
        </Grid>

        <!-- Плавающая стеклянная капсула таб-бара (GlassTabBar.kt): отступ 14 от краёв, высота 64,
             "линза" скользит под выбранной вкладкой с пружиной. -->
        <controls:GlassPanel Style="{StaticResource GlassStrong}" CornerRadius="999" Height="64"
                             VerticalAlignment="Bottom" Margin="14,0,14,10" Padding="5">
            <Grid x:Name="TabHost" SizeChanged="OnTabHostSizeChanged">
                <controls:GlassPanel x:Name="Lens" Style="{StaticResource GlassPill}" Tint="{DynamicResource LensBrush}"
                                     HorizontalAlignment="Left">
                    <controls:GlassPanel.RenderTransform>
                        <TranslateTransform x:Name="LensX"/>
                    </controls:GlassPanel.RenderTransform>
                </controls:GlassPanel>
                <UniformGrid Rows="1" Columns="4">
                    <RadioButton Style="{StaticResource GlassTab}" Tag="{StaticResource TabIconHome}" Content="Главная"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                    <RadioButton Style="{StaticResource GlassTab}" Tag="{StaticResource TabIconServers}" Content="Серверы"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource GlassTab}" Tag="{StaticResource TabIconPlans}" Content="Подписка"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"/>
                    <RadioButton Style="{StaticResource GlassTab}" Tag="{StaticResource TabIconSettings}" Content="Настройки"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"/>
                </UniformGrid>
            </Grid>
        </controls:GlassPanel>
    </Grid>
</UserControl>
