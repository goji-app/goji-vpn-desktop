<UserControl x:Class="GodjiVpn.Views.FaqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:GodjiVpn.Utils"
             xmlns:controls="clr-namespace:GodjiVpn.Controls">
    <!-- Частые вопросы v5 «Стекло» — FaqScreen.kt: разделы — стеклянные карточки, вопросы —
         строки через разделитель, раскрываются по нажатию (+/−). -->
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource GlassCircleButton}" Command="{Binding BackCommand}" AutomationProperties.Name="Назад">
                <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource Icon}" Width="20" Height="20" Fill="{DynamicResource TextPrimaryBrush}"/>
            </Button>
            <TextBlock Grid.Column="1" Text="Частые вопросы" FontWeight="SemiBold" FontSize="{s:Fs 22}" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,16">

                <controls:Spinner Foreground="{DynamicResource TealBrush}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,30,0,0"
                                  Visibility="{Binding Loading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <controls:GlassPanel Style="{StaticResource GlassCard}" CornerRadius="24"
                                     Visibility="{Binding LoadError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="20" HorizontalAlignment="Center">
                        <TextBlock Text="Не удалось загрузить вопросы" FontWeight="Medium" FontSize="{s:Fs 12.5}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Style="{StaticResource ChipButton}" Content="Повторить" Margin="0,10,0,0" HorizontalAlignment="Center"
                                Command="{Binding RetryCommand}"/>
                    </StackPanel>
                </controls:GlassPanel>

                <controls:GlassPanel Style="{StaticResource GlassCard}" CornerRadius="24"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Пока нет вопросов" Margin="20" HorizontalAlignment="Center" FontWeight="Medium" FontSize="{s:Fs 12.5}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </controls:GlassPanel>

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{s:Fs 14}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="6,0,6,8" TextWrapping="Wrap"
                                           Visibility="{Binding HasName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <controls:GlassPanel Style="{StaticResource GlassCard}" CornerRadius="24">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Rectangle x:Name="Sep" Style="{StaticResource Hair}"/>
                                                    <Button Style="{StaticResource RowButton}" Padding="16,13" Click="OnQuestionClick" Tag="{Binding}"
                                                            AutomationProperties.Name="{Binding Question}">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Question}" FontWeight="SemiBold" FontSize="{s:Fs 13}" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="{s:Fs 17}" Foreground="{DynamicResource TealDeepBrush}"
                                                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="+"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                    <Setter Property="Text" Value="−"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Answer}" FontWeight="Medium" FontSize="{s:Fs 12}" LineHeight="17" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"
                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </controls:GlassPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
