<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Токены дизайна v5 «Стекло» — те же, что в Windows-клиенте (Themes/LightTheme.xaml и
         DarkTheme.xaml), в виде тематических словарей Avalonia: смена
         Application.RequestedThemeVariant перекрашивает всё через DynamicResource. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="BgSolidBrush" Color="#E6ECF1"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#59FFFFFF"/>
            <SolidColorBrush x:Key="InkBrush" Color="#0B1F1C"/>
            <SolidColorBrush x:Key="InkShadowBrush" Color="#06120F"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0B1F1C"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E0B1F1C"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#7A0B1F1C"/>
            <SolidColorBrush x:Key="TealBrush" Color="#00A79B"/>
            <Color x:Key="TealColor">#00A79B</Color>
            <SolidColorBrush x:Key="TealBrightBrush" Color="#2AC9BA"/>
            <SolidColorBrush x:Key="TealDeepBrush" Color="#007A70"/>
            <SolidColorBrush x:Key="TealTintBrush" Color="#2400A79B"/>
            <SolidColorBrush x:Key="TealTintBorderBrush" Color="#5900A79B"/>
            <SolidColorBrush x:Key="TerracottaBrush" Color="#E0693F"/>
            <SolidColorBrush x:Key="TerracottaDeepBrush" Color="#B2482A"/>
            <SolidColorBrush x:Key="TerracottaTintBrush" Color="#80FFD6C4"/>
            <SolidColorBrush x:Key="TerracottaTintBorderBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#C98B12"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#D2432C"/>
            <SolidColorBrush x:Key="JamBgBrush" Color="#8CFFC8B9"/>
            <SolidColorBrush x:Key="JamBorderBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="JamTextBrush" Color="#C2412A"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#59FFFFFF"/>
            <SolidColorBrush x:Key="TrackBgBrush" Color="#170B1F1C"/>
            <SolidColorBrush x:Key="BorderTealBrush" Color="#2600A79B"/>
            <SolidColorBrush x:Key="PurpleBrush" Color="#5B3BD6"/>
            <SolidColorBrush x:Key="HairBrush" Color="#140B1F1C"/>
            <SolidColorBrush x:Key="SelBgBrush" Color="#1A00A79B"/>
            <SolidColorBrush x:Key="ThumbBrush" Color="#EBFFFFFF"/>
            <SolidColorBrush x:Key="LensBrush" Color="#BFFFFFFF"/>
            <SolidColorBrush x:Key="RingCoreBrush" Color="#E0FFFFFF"/>
            <SolidColorBrush x:Key="InkBtnBrush" Color="#0B1F1C"/>
            <SolidColorBrush x:Key="InkBtnTextBrush" Color="#F4FAF9"/>
            <SolidColorBrush x:Key="PressedRowBrush" Color="#147F7F7F"/>
            <SolidColorBrush x:Key="BannerOkBrush" Color="#8CC8F5EC"/>
            <SolidColorBrush x:Key="BannerWarnBrush" Color="#8CFFDCCD"/>
            <SolidColorBrush x:Key="ConnectingDotBrush" Color="#E0A526"/>
            <SolidColorBrush x:Key="OffDotBrush" Color="#4D0B1F1C"/>
            <Color x:Key="AccentGlowColor">#5900A79B</Color>
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#2AC9BA" Offset="0"/>
            <GradientStop Color="#00A79B" Offset="0.55"/>
            <GradientStop Color="#008F84" Offset="1"/>
            </LinearGradientBrush>
            <Color x:Key="GlassColor">#33FFFFFF</Color>
            <Color x:Key="GlassStrongColor">#66FFFFFF</Color>
            <Color x:Key="GlassFaintColor">#29FFFFFF</Color>
            <Color x:Key="GlassSpotColor">#8CFFFFFF</Color>
            <Color x:Key="GlassGlossColor">#40FFFFFF</Color>
            <Color x:Key="RimAColor">#FFFFFFFF</Color>
            <Color x:Key="RimBColor">#40FFFFFF</Color>
            <Color x:Key="RimCColor">#0FFFFFFF</Color>
            <Color x:Key="RimDColor">#B3FFFFFF</Color>
            <Color x:Key="InnerTopColor">#F2FFFFFF</Color>
            <Color x:Key="InnerBottomColor">#38283C5A</Color>
            <Color x:Key="GlassShadowColor">#2E3C1E78</Color>
            <Color x:Key="BaseTopColor">#F2F4F7</Color>
            <Color x:Key="BaseMidColor">#E6ECF1</Color>
            <Color x:Key="BaseBottomColor">#DDE7EA</Color>
            <Color x:Key="Blob1Color">#6FD1C4</Color>
            <Color x:Key="Blob2Color">#AFA6F2</Color>
            <Color x:Key="Blob3Color">#F2C2A5</Color>
            <Color x:Key="Blob4Color">#8EC3EA</Color>
            <x:Double x:Key="BlobAlpha">0.6</x:Double>
            <Color x:Key="TexLineColor">#12284660</Color>
            <Color x:Key="TexDotColor">#21284660</Color>
            <SolidColorBrush x:Key="PanelBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="PanelAltBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#00A79B"/>
            <SolidColorBrush x:Key="AccentDimBrush" Color="#007A70"/>
            <SolidColorBrush x:Key="TextBrush" Color="#0B1F1C"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="BgSolidBrush" Color="#0C1320"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#0B1F1C"/>
            <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="InkBrush" Color="#F1F7F6"/>
            <SolidColorBrush x:Key="InkShadowBrush" Color="#C7CBD4"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCE8EEF4"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#99E8EEF4"/>
            <SolidColorBrush x:Key="TealBrush" Color="#5FFFE6"/>
            <Color x:Key="TealColor">#5FFFE6</Color>
            <SolidColorBrush x:Key="TealBrightBrush" Color="#34E3D2"/>
            <SolidColorBrush x:Key="TealDeepBrush" Color="#7FFFEA"/>
            <SolidColorBrush x:Key="TealTintBrush" Color="#242FE0CF"/>
            <SolidColorBrush x:Key="TealTintBorderBrush" Color="#595FFFE6"/>
            <SolidColorBrush x:Key="TerracottaBrush" Color="#FF8E62"/>
            <SolidColorBrush x:Key="TerracottaDeepBrush" Color="#FFB08E"/>
            <SolidColorBrush x:Key="TerracottaTintBrush" Color="#6178321C"/>
            <SolidColorBrush x:Key="TerracottaTintBorderBrush" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#E0A63C"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FF7A66"/>
            <SolidColorBrush x:Key="JamBgBrush" Color="#66782819"/>
            <SolidColorBrush x:Key="JamBorderBrush" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="JamTextBrush" Color="#FF8A6E"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="TrackBgBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="BorderTealBrush" Color="#262FE0CF"/>
            <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CFF"/>
            <SolidColorBrush x:Key="HairBrush" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="SelBgBrush" Color="#172FE0CF"/>
            <SolidColorBrush x:Key="ThumbBrush" Color="#29FFFFFF"/>
            <SolidColorBrush x:Key="LensBrush" Color="#2EFFFFFF"/>
            <SolidColorBrush x:Key="RingCoreBrush" Color="#E610141C"/>
            <SolidColorBrush x:Key="InkBtnBrush" Color="#F1F7F6"/>
            <SolidColorBrush x:Key="InkBtnTextBrush" Color="#0B1F1C"/>
            <SolidColorBrush x:Key="PressedRowBrush" Color="#147F7F7F"/>
            <SolidColorBrush x:Key="BannerOkBrush" Color="#61145A50"/>
            <SolidColorBrush x:Key="BannerWarnBrush" Color="#666E2D19"/>
            <SolidColorBrush x:Key="ConnectingDotBrush" Color="#E0A526"/>
            <SolidColorBrush x:Key="OffDotBrush" Color="#59FFFFFF"/>
            <Color x:Key="AccentGlowColor">#592FE0CF</Color>
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#34E3D2" Offset="0"/>
            <GradientStop Color="#10B8A9" Offset="0.55"/>
            <GradientStop Color="#079487" Offset="1"/>
            </LinearGradientBrush>
            <Color x:Key="GlassColor">#9E12161E</Color>
            <Color x:Key="GlassStrongColor">#BD161A24</Color>
            <Color x:Key="GlassFaintColor">#6612161E</Color>
            <Color x:Key="GlassSpotColor">#12FFFFFF</Color>
            <Color x:Key="GlassGlossColor">#12FFFFFF</Color>
            <Color x:Key="RimAColor">#8CFFFFFF</Color>
            <Color x:Key="RimBColor">#14FFFFFF</Color>
            <Color x:Key="RimCColor">#05FFFFFF</Color>
            <Color x:Key="RimDColor">#47FFFFFF</Color>
            <Color x:Key="InnerTopColor">#47FFFFFF</Color>
            <Color x:Key="InnerBottomColor">#80000000</Color>
            <Color x:Key="GlassShadowColor">#590A0528</Color>
            <Color x:Key="BaseTopColor">#080C12</Color>
            <Color x:Key="BaseMidColor">#0C1320</Color>
            <Color x:Key="BaseBottomColor">#06100F</Color>
            <Color x:Key="Blob1Color">#0F8C80</Color>
            <Color x:Key="Blob2Color">#4332A8</Color>
            <Color x:Key="Blob3Color">#8A3D2A</Color>
            <Color x:Key="Blob4Color">#1B4F8C</Color>
            <x:Double x:Key="BlobAlpha">0.32</x:Double>
            <Color x:Key="TexLineColor">#09A0DCE6</Color>
            <Color x:Key="TexDotColor">#0FC8E6F0</Color>
            <SolidColorBrush x:Key="PanelBrush" Color="#9E12161E"/>
            <SolidColorBrush x:Key="PanelAltBrush" Color="#9E12161E"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#5FFFE6"/>
