<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:GodjiVpn.Controls"
             x:Class="GodjiVpn.Views.SupportListView">
    <!-- Список обращений: заголовок + закрыть, "Новое обращение", FAQ, сегмент
         Открытые/История, строки обращений в одной стеклянной карточке. -->
    <UserControl.Styles>
        <Style Selector="ItemsControl.tickets ContentPresenter:nth-child(1) Rectangle.sep">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource TealDeepBrush}"/>
        </Style>
        <Style Selector="TextBlock.status.closed">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="20,16,16,10">
            <TextBlock Classes="title" Text="Поддержка" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="circle" Click="OnCloseClick" ToolTip.Tip="Закрыть">
                <Path Classes="icon" Data="{StaticResource IconClose}" Width="16" Height="16"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,0,16,16">
                <Button Classes="ink" Height="48" FontSize="14" Content="Новое обращение" Command="{Binding NewTicketCommand}"/>
                <Button Classes="link" Content="Часто задаваемые вопросы" Padding="8,12" Command="{Binding OpenFaqCommand}"/>

                <c:SegmentedControl ItemsSource="{Binding TabLabels}" SelectedIndex="{Binding Tab, Mode=OneWay}"
                                    SelectCommand="{Binding SelectTabCommand}"/>

                <c:Spinner Width="24" Height="24" HorizontalAlignment="Center" Margin="0,30,0,0" IsVisible="{Binding Loading}"/>

                <c:GlassPanel Classes="card" CornerRadius="24" Margin="0,14,0,0" IsVisible="{Binding LoadError}">
                    <StackPanel Margin="20" HorizontalAlignment="Center">
                        <TextBlock Classes="muted" Text="Не удалось загрузить обращения" FontSize="12.5"/>
                        <Button Classes="chip" Content="Повторить" Margin="0,10,0,0" HorizontalAlignment="Center" Command="{Binding RetryCommand}"/>
                    </StackPanel>
                </c:GlassPanel>

                <c:GlassPanel Classes="card" CornerRadius="24" Margin="0,14,0,0" IsVisible="{Binding ShowEmpty}">
                    <TextBlock Classes="muted" Margin="20" HorizontalAlignment="Center" FontSize="12.5" Text="{Binding EmptyText}"/>
                </c:GlassPanel>

                <c:GlassPanel Classes="card" CornerRadius="24" Margin="0,14,0,0" IsVisible="{Binding ShowTickets}">
                    <ItemsControl Classes="tickets" ItemsSource="{Binding Tickets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Rectangle Classes="hair sep"/>
                                    <Button Classes="row" Padding="16,12" Click="OnTicketClick" Tag="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Classes="muted" Text="{Binding LastMessage}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" IsVisible="{Binding LastMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Classes="status" Classes.closed="{Binding IsClosed}" Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DateLabel, StringFormat=' · {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               IsVisible="{Binding DateLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="10" MinWidth="20" Height="20"
                                                    Padding="6,0" Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasUnread}">
                                                <TextBlock Text="{Binding UnreadCount}" FontSize="10.5" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Path Grid.Column="2" Classes="icon" Data="{StaticResource IconChevronRight}" Width="15" Height="15"
                                                  Fill="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </c:GlassPanel>

                <c:Spinner HorizontalAlignment="Center" Margin="0,14,0,0" IsVisible="{Binding LoadingMore}"/>
                <Button Classes="link" Content="Показать ещё" Padding="8,12" Command="{Binding LoadMoreCommand}" IsVisible="{Binding ShowLoadMore}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
