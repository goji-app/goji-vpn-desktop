<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:GodjiVpn.Controls"
             x:Class="GodjiVpn.Views.FaqView">
    <!-- Частые вопросы: разделы — стеклянные карточки, вопросы раскрываются по нажатию. -->
    <UserControl.Styles>
        <Style Selector="ItemsControl.questions ContentPresenter:nth-child(1) Rectangle.sep">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Margin="16,16,16,10">
            <Button Classes="circle" Command="{Binding BackCommand}" ToolTip.Tip="Назад">
                <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Width="20" Height="20"/>
            </Button>
            <TextBlock Grid.Column="1" Classes="subTitle" Text="Частые вопросы" Margin="12,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,0,16,16">
                <c:Spinner Width="24" Height="24" HorizontalAlignment="Center" Margin="0,30,0,0" IsVisible="{Binding Loading}"/>

                <c:GlassPanel Classes="card" CornerRadius="24" IsVisible="{Binding LoadError}">
                    <StackPanel Margin="20" HorizontalAlignment="Center">
                        <TextBlock Classes="muted" Text="Не удалось загрузить вопросы" FontSize="12.5"/>
                        <Button Classes="chip" Content="Повторить" Margin="0,10,0,0" HorizontalAlignment="Center" Command="{Binding RetryCommand}"/>
                    </StackPanel>
                </c:GlassPanel>

                <c:GlassPanel Classes="card" CornerRadius="24" IsVisible="{Binding IsEmpty}">
                    <TextBlock Classes="muted" Text="Пока нет вопросов" Margin="20" HorizontalAlignment="Center" FontSize="12.5"/>
                </c:GlassPanel>

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="6,0,6,8" TextWrapping="Wrap"
                                           IsVisible="{Binding HasName}"/>
                                <c:GlassPanel Classes="card" CornerRadius="24">
                                    <ItemsControl Classes="questions" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Rectangle Classes="hair sep"/>
                                                    <Button Classes="row" Padding="16,13" Command="{Binding ToggleCommand}">
                                                        <StackPanel>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Question}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ToggleGlyph}" FontWeight="Bold" FontSize="17"
                                                                           Foreground="{DynamicResource TealDeepBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <TextBlock Classes="muted" Text="{Binding Answer}" LineHeight="17" Margin="0,7,0,0"
                                                                       IsVisible="{Binding IsExpanded}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </c:GlassPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
